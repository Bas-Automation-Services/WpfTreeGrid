<Window x:Class="WpfTreeGrid.Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tg="clr-namespace:WpfTreeGrid;assembly=WpfTreeGrid"
        Title="WpfTreeGrid demo"
        Width="1000"
        Height="640">
    <DockPanel>
        <ToolBar DockPanel.Dock="Top">
            <TextBlock Text="Search" VerticalAlignment="Center" Margin="4,0" />
            <TextBox x:Name="SearchBox" Width="180" TextChanged="OnSearchChanged" />
            <Separator />
            <CheckBox Content="Flat list" IsChecked="{Binding IsFlat, ElementName=Grid}" />
            <Separator />
            <Button Content="Expand all" Command="{x:Static tg:TreeDataGrid.ExpandAllCommand}" CommandTarget="{Binding ElementName=Grid}" />
            <Button Content="Collapse all" Command="{x:Static tg:TreeDataGrid.CollapseAllCommand}" CommandTarget="{Binding ElementName=Grid}" />
            <Button Content="Clear filters" Command="{x:Static tg:TreeDataGrid.ClearFiltersCommand}" CommandTarget="{Binding ElementName=Grid}" />
            <Separator />
            <Button Content="Add part to selection" Click="OnAddPartClick" />
            <Button Content="Remove selected" Click="OnRemoveClick" />
        </ToolBar>

        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock>
                <Run Text="{Binding Items.Count, ElementName=Grid, Mode=OneWay}" /> rows shown,
                <Run Text="{Binding Selection.Count, Mode=OneWay}" /> selected
            </TextBlock>
            <Separator />
            <TextBlock x:Name="FilterSummary" />
        </StatusBar>

        <tg:TreeDataGrid x:Name="Grid"
                         ItemsSource="{Binding Roots}"
                         BindableSelectedItems="{Binding Selection}"
                         AutoExpandMode="RootNodesExpanded"
                         AllowFiltering="True"
                         AllowEditing="True"
                         AllowResizingColumns="True"
                         FilterLevel="Extended"
                         ExpandFilterMatches="True"
                         SelectionMode="Extended"
                         GridLinesVisibility="Horizontal"
                         HorizontalGridLinesBrush="#FFE6E6E6"
                         EnableRowVirtualization="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         FilterChanged="OnFilterChanged">
            <tg:TreeDataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Expand selected" Command="{x:Static tg:TreeDataGrid.ExpandSelectedCommand}" />
                    <MenuItem Header="Collapse selected" Command="{x:Static tg:TreeDataGrid.CollapseSelectedCommand}" />
                    <Separator />
                    <MenuItem Header="Expand all" Command="{x:Static tg:TreeDataGrid.ExpandAllCommand}" />
                    <MenuItem Header="Collapse all" Command="{x:Static tg:TreeDataGrid.CollapseAllCommand}" />
                </ContextMenu>
            </tg:TreeDataGrid.ContextMenu>
            <tg:TreeDataGrid.Columns>
                <tg:TreeGridTextColumn MappingName="Name" ColumnSizer="Star" />
                <tg:TreeGridCheckBoxColumn MappingName="IsSelected" HeaderText="Use" Width="44" AllowFiltering="False" />
                <tg:TreeGridTextColumn MappingName="Type" AllowEditing="False" ColumnSizer="Star" />
                <tg:TreeGridTextColumn MappingName="Material" AllowEditing="False" ColumnSizer="Star" />
                <tg:TreeGridNumericColumn MappingName="Mass" HeaderText="Mass (kg)" NumberDecimalDigits="3" AllowEditing="False" Width="90" />
                <tg:TreeGridNumericColumn MappingName="Quantity" HeaderText="Qty" NumberDecimalDigits="0" AllowEditing="False" Width="60" />
            </tg:TreeDataGrid.Columns>
        </tg:TreeDataGrid>
    </DockPanel>
</Window>
